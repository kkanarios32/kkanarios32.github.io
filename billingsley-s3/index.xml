          </fr:frontmatter>
          <fr:mainmatter>
            <html:p>For each subset <fr:tex display="inline"><![CDATA[A]]></fr:tex> of <fr:tex display="inline"><![CDATA[\Omega ]]></fr:tex>, <fr:tex display="block"><![CDATA[P^{*}(A)=\mathrm {inf}\,\sum _{n}P(A_{n}),]]></fr:tex> where <fr:tex display="inline"><![CDATA[A \subset  \bigcup _{n = 1}^{\infty } A_n.]]></fr:tex></html:p>
